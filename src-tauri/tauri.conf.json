{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manuvers",
  "version": "0.1.0",
  "identifier": "fr.datando.manuvers",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Manuvers",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https: ipc: http://ipc.localhost; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Avatar compagnon de vos automatisations",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
